---
import { isGated, stepperStages } from "../components/lesson/stages";
import { type Locale, localizedPath } from "../i18n/config";
import { useTranslations } from "../i18n/t";
import Page from "./Page.astro";

interface Props {
  /** Content id shared across languages; keys progress. */
  lessonId: string;
  lang: Locale;
  /** Language the lesson content is written in (differs from `lang` on a fallback page). */
  contentLang: Locale;
  isFallback: boolean;
  title: string;
  summary: string;
  minutes: number;
  pathId: string;
  moduleTitle: string;
  moduleOrder: number;
}

const {
  lessonId,
  lang,
  contentLang,
  isFallback,
  title,
  summary,
  minutes,
  pathId,
  moduleTitle,
  moduleOrder,
} = Astro.props;
const t = useTranslations(lang);
---

<Page lang={lang} title={`${title} | ${t("site.name")}`} description={summary}>
  <header class="lesson-head" lang={contentLang}>
    <a class="module" href={localizedPath(lang, pathId)}>
      {t("path.module", { n: moduleOrder })}: {moduleTitle}
    </a>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    <p class="meta">{t("lesson.minutes", { n: minutes })}</p>
  </header>

  {
    isFallback && (
      <p class="fallback" role="note">
        {t("lesson.fallback")}
      </p>
    )
  }

  <div class="lesson" data-lesson={lessonId}>
    <nav class="track" aria-label={t("lesson.stages")}>
      <ol>
        {
          stepperStages.map((stage, i) => (
            <li>
              <a href={`#${stage}`} data-stage-link={stage} data-gated={isGated(stage) ? "" : undefined}>
                <span class="space" aria-hidden="true">
                  {isGated(stage) && (
                    <svg class="lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                      <rect x="5" y="11" width="14" height="10" rx="2" />
                      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                  )}
                </span>
                <span class="label">
                  <span class="n">{i + 1}.</span> {t(`lesson.stage.${stage}`)}
                </span>
                {isGated(stage) && <span class="visually-hidden lock-label">({t("lesson.locked")})</span>}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="track-actions">
        <a class="skip" href="#predict">{t("lesson.skipTheory")}</a>
        <button type="button" class="show-all" data-show-all>{t("lesson.showAll")}</button>
      </div>
    </nav>

    <p class="visually-hidden" aria-live="polite" data-unlock-status data-message={t("lesson.unlocked")}></p>

    <article class="lesson-body" lang={contentLang}>
      <slot />
    </article>
  </div>
</Page>

<script>
  import { RUN_FINISHED_EVENT } from "../lib/events";
  import { isUnlocked, markUnlocked, readProgress } from "../lib/progress";

  const lesson = document.querySelector<HTMLElement>("[data-lesson]");
  const lessonId = lesson?.dataset["lesson"];

  if (lesson && lessonId) {
    const status = lesson.querySelector<HTMLElement>("[data-unlock-status]");
    const showAll = lesson.querySelector<HTMLButtonElement>("[data-show-all]");

    const unlock = (persist: boolean, announce: boolean) => {
      if (lesson.dataset["unlocked"] !== undefined) return;
      lesson.dataset["unlocked"] = "";
      if (showAll) showAll.hidden = true;
      if (persist) markUnlocked(globalThis.localStorage, lessonId, new Date());
      if (announce && status) status.textContent = status.dataset["message"] ?? "";
    };

    if (isUnlocked(readProgress(globalThis.localStorage), lessonId)) unlock(false, false);
    document.addEventListener(RUN_FINISHED_EVENT, () => unlock(true, true));
    showAll?.addEventListener("click", () => unlock(true, true));

    // Mark the stage in view as the current step.
    const links = new Map(
      [...lesson.querySelectorAll<HTMLAnchorElement>("[data-stage-link]")].map((a) => [
        a.dataset["stageLink"],
        a,
      ]),
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links.values()) link.removeAttribute("aria-current");
          const current = links.get(entry.target.id);
          current?.setAttribute("aria-current", "step");
          // On phones the track is a sideways row: keep the current stage visible.
          current?.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    for (const id of links.keys()) {
      const section = id ? document.getElementById(id) : null;
      if (section) observer.observe(section);
    }
  }
</script>

<style>
  .lesson-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .module {
    color: var(--color-ink-muted);
  }

  .summary {
    font-size: 1.1875rem;
  }

  .meta {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  .fallback {
    padding: var(--space-4) var(--space-5);
    border: var(--outline-waiting);
    border-radius: var(--radius-card);
  }

  /* Narrow screens: the track is a sticky row of pills above the content. */
  .lesson {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .track {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    background: var(--color-ground);
  }

  /* One row that scrolls sideways, so the sticky track stays short on phones. */
  .track ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-2);
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .track li {
    flex: none;
  }

  .track ol a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: 0 var(--space-4) 0 var(--space-2);
    border: var(--outline);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--text-small);
    font-weight: 700;
    text-decoration: none;
  }

  .space {
    flex: none;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2.5px solid currentColor;
    background: var(--color-surface);
  }

  .n {
    font-variant-numeric: tabular-nums;
  }

  .lock,
  .lock-label {
    display: none;
  }

  .track ol a[aria-current="step"] {
    color: var(--color-ink);
  }

  .track ol a[aria-current="step"] .space {
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  /* Gated stages while closed: dashed space with a lock, muted label. */
  :global(.js) .lesson:not([data-unlocked]) [data-gated] {
    color: var(--color-ink-muted);
  }

  :global(.js) .lesson:not([data-unlocked]) [data-gated] .space {
    border-style: dashed;
  }

  :global(.js) .lesson:not([data-unlocked]) [data-gated] .lock,
  :global(.js) .lesson:not([data-unlocked]) [data-gated] .lock-label {
    display: inline;
  }

  .track-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-4);
  }

  .skip,
  .show-all {
    font-size: var(--text-small);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .show-all {
    display: none;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    text-decoration: underline;
    cursor: pointer;
  }

  :global(.js) .lesson:not([data-unlocked]) .show-all {
    display: inline-flex;
    align-items: center;
  }

  .lesson-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  /*
   * Wide screens: the track becomes the lesson's path, a vertical line of spaces
   * beside the text, like the path map. The board keeps the full main column.
   */
  @media (min-width: 1080px) {
    .lesson {
      display: grid;
      grid-template-columns: 12.5rem minmax(0, 1fr);
      column-gap: var(--space-8);
      align-items: start;
    }

    .track {
      top: var(--space-6);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-5);
      padding-block: 0;
      background: none;
    }

    .track ol {
      flex-direction: column;
      gap: 0;
      overflow: visible;
    }

    .track li {
      position: relative;
    }

    /* The line joining each space to the next. */
    .track li:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 10px;
      top: 34px;
      bottom: -10px;
      width: 3px;
      border-radius: 2px;
      background: var(--color-slot);
    }

    .track ol a {
      min-height: 0;
      padding: 10px 0;
      border: 0;
      border-radius: 0;
      background: none;
      font-size: var(--text-body);
      font-weight: 500;
      color: var(--color-ink-muted);
      gap: var(--space-3);
    }

    .track ol a:hover .label {
      text-decoration: underline;
    }

    .track ol a[aria-current="step"] {
      font-weight: 800;
    }

    .n {
      display: none;
    }

    .track-actions {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 34px;
      text-align: left;
    }

    .show-all {
      min-height: 0;
      padding-block: var(--space-1);
      text-align: left;
    }
  }
</style>
