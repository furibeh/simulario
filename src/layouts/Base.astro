---
import "@fontsource-variable/lexend";
import "../styles/tokens.css";
import "../styles/base.css";
import {
  defaultLocale,
  type Locale,
  locales,
  ogLocales,
  pagePathname,
  switchLocale,
} from "../i18n/config";
import { useTranslations } from "../i18n/t";
import { THEME_KEY } from "../lib/theme";

interface Props {
  lang: Locale;
  title: string;
  description?: string | undefined;
  /** Open Graph type: "article" for lessons, "website" for everything else. */
  ogType?: "website" | "article" | undefined;
  /** False for pages that must stay out of search results (404): noindex, no canonical, no share tags. */
  indexable?: boolean | undefined;
}

const { lang, title, description, ogType = "website", indexable = true } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const pathname = pagePathname(Astro.url.pathname);
const canonical = new URL(pathname, site).href;
const alternates = locales.map((locale) => ({
  locale,
  href: new URL(switchLocale(pathname, locale), site).href,
}));
// Social networks need an absolute URL to a raster image. Source: docs/assets/og.svg.
const shareImage = new URL("/og.png", site).href;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {description && <meta name="description" content={description} />}
    {
      indexable ? (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={alt.locale} href={alt.href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(switchLocale(pathname, defaultLocale), site).href}
          />
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content={t("site.name")} />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={ogLocales[lang]} />
          {locales
            .filter((locale) => locale !== lang)
            .map((locale) => (
              <meta property="og:locale:alternate" content={ogLocales[locale]} />
            ))}
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t("share.imageAlt")} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <script is:inline define:vars={{ themeKey: THEME_KEY }}>
      // Lets CSS tell that scripts run (gated lesson stages stay open without JS).
      document.documentElement.classList.add("js");
      // Apply a stored theme before first paint. Absent = follow the system.
      try {
        const theme = localStorage.getItem(themeKey);
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
