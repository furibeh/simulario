---
import { defaultLocale, isLocale } from "../../i18n/config";
import { useTranslations } from "../../i18n/t";
import { isGated, type StageId, stageIds } from "./stages";

interface Props {
  stage: StageId;
  /** Language of the content; defaults to the page's locale. */
  lang?: string;
}

const { stage, lang } = Astro.props;
const locale = isLocale(lang)
  ? lang
  : isLocale(Astro.currentLocale)
    ? Astro.currentLocale
    : defaultLocale;
const t = useTranslations(locale);
if (!stageIds.includes(stage)) throw new Error(`Unknown lesson stage "${stage}"`);
const optional = stage === "deeper";
const gated = isGated(stage);
---

{
  optional ? (
    <details class="stage deeper" id={stage}>
      <summary>
        <h2>{t(`lesson.stage.${stage}`)}</h2>
      </summary>
      <div class="body">
        <slot />
      </div>
    </details>
  ) : (
    <section
      class:list={["stage", stage]}
      id={stage}
      aria-labelledby={`${stage}-title`}
      data-gated={gated ? "" : undefined}
    >
      <h2 id={`${stage}-title`}>{t(`lesson.stage.${stage}`)}</h2>
      {gated && (
        <div class="locked-note">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
          <p>{t("lesson.locked.note")}</p>
          <a href="#run">{t("lesson.locked.goRun")}</a>
        </div>
      )}
      <div class="body">
        <slot />
      </div>
    </section>
  )
}

<style>
  .stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    scroll-margin-top: 88px;
  }

  /* Gated stages: closed only when scripts run and the lesson is not unlocked yet. */
  .locked-note {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: var(--outline-waiting);
    border-radius: var(--radius-card);
    color: var(--color-ink-muted);
  }

  .locked-note a {
    color: var(--color-ink);
    font-weight: 700;
  }

  :global(.js [data-lesson]:not([data-unlocked])) [data-gated] .locked-note {
    display: flex;
  }

  :global(.js [data-lesson]:not([data-unlocked])) [data-gated] .body {
    display: none;
  }

  [data-gated] .body {
    animation: reveal var(--duration-move) var(--ease-move);
  }

  @keyframes reveal {
    from {
      opacity: 0;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0;
    padding-left: 1.4em;
    max-width: var(--measure);
  }

  .body :global(li + li) {
    margin-top: var(--space-2);
  }

  .body :global(table) {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .body :global(th),
  .body :global(td) {
    padding: 6px 12px;
    border-bottom: 1px solid var(--color-slot);
    text-align: left;
  }

  .body :global(blockquote) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-slot);
    max-width: var(--measure);
  }

  .body :global(pre) {
    margin: 0;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: var(--outline);
    overflow-x: auto;
  }

  .deeper {
    border: var(--outline-waiting);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
  }

  .deeper summary {
    cursor: pointer;
    list-style-position: outside;
  }

  .deeper summary h2 {
    display: inline;
    font-size: var(--text-h3);
  }

  .deeper .body {
    margin-top: var(--space-4);
  }
</style>
