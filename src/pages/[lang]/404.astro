---
import NotFound from "../../components/site/NotFound.astro";
import { type Locale, locales } from "../../i18n/config";
import { useTranslations } from "../../i18n/t";
import Page from "../../layouts/Page.astro";

// Emitted as /<lang>/404.html. Cloudflare Pages serves the nearest 404.html up the
// requested path, so a missing /en/… page gets the English one.
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<Page lang={lang} title={`${t("notFound.title")} | ${t("site.name")}`} indexable={false}>
  <NotFound lang={lang} />
</Page>
