---
import { render } from "astro:content";
import type { Locale } from "../../../i18n/config";
import Lesson from "../../../layouts/Lesson.astro";
import { getLessonPages } from "../../../lib/catalog";

export async function getStaticPaths() {
  const pages = await getLessonPages();
  return pages.map((page) => ({
    params: { lang: page.lang, path: page.pathId, lesson: page.slug },
    props: page,
  }));
}

type Props = Awaited<ReturnType<typeof getLessonPages>>[number];

const { entry, module, pathId, contentLang, isFallback, slug } = Astro.props;
const lang = Astro.params.lang as Locale;
const { Content } = await render(entry);
---

<Lesson
  lessonId={slug}
  lang={lang}
  contentLang={contentLang}
  isFallback={isFallback}
  title={entry.data.title}
  summary={entry.data.summary}
  minutes={entry.data.minutes}
  pathId={pathId}
  moduleTitle={module.data.title[lang]}
  moduleOrder={module.data.order}
>
  <Content />
</Lesson>
